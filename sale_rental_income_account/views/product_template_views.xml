<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_rental_income_account" model="ir.ui.view">
        <field name="name">product.template.form.rental.income.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contabilidad de alquiler"
                      name="rental_accounting"
                      groups="account.group_account_user">
                    <group string="Ingresos por alquiler">
                        <field name="property_account_rental_income_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <div class="text-muted" colspan="2">
                            Si se deja vacío, las facturas de alquiler usarán la cuenta
                            de ingresos normal del producto o de su categoría. En pedidos
                            que no sean de alquiler no se modifica el comportamiento estándar.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
