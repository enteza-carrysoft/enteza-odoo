<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_rental_income_account" model="ir.ui.view">
        <field name="name">product.template.form.rental.income.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contabilidad de alquiler"
                      name="rental_accounting"
                      groups="account.group_account_user">
                    <group string="Ingresos por alquiler">
                        <field name="property_account_rental_income_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="rental_taxes_id"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <div class="text-muted" colspan="2">
                            Campos aplicados solo a las líneas de alquiler. Si se dejan
                            vacíos se usa lo definido en la categoría del producto y, en
                            su defecto, la cuenta e impuestos de venta estándar. Las
                            líneas que no son de alquiler mantienen el comportamiento
                            nativo de Odoo.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
