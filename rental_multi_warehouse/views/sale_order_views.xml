<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  PEDIDO DE VENTA: Botón traslados + columna disponibilidad   -->
    <!-- ============================================================ -->

    <record id="sale_order_form_rental_multi_wh" model="ir.ui.view">
        <field name="name">sale.order.form.rental.multi.wh</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Botón inteligente: Traslados inter-almacén -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rental_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="rental_transfer_count == 0">
                    <field name="rental_transfer_count"
                           widget="statinfo"
                           string="Traslados"/>
                </button>
            </xpath>

            <!-- Campos de disponibilidad en las líneas del pedido -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']"
                   position="after">
                <field name="rental_availability_status"
                       column_invisible="not parent.is_rental_order"
                       widget="badge"
                       decoration-success="rental_availability_status == 'ok'"
                       decoration-info="rental_availability_status == 'transfer_needed'"
                       decoration-danger="rental_availability_status == 'deficit'"
                       optional="show"
                       string="Estado"/>
                <field name="rental_availability_json"
                       column_invisible="not parent.is_rental_order"
                       widget="rental_multi_wh_availability"
                       optional="show"
                       string="Disponibilidad"/>
                <field name="rental_total_available"
                       column_invisible="True"/>
                <field name="rental_needs_transfer"
                       column_invisible="True"/>
            </xpath>

        </field>
    </record>


</odoo>
