<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Verificación diaria de traslados pendientes próximas 2 semanas -->
        <record id="ir_cron_check_rental_transfers" model="ir.cron">
            <field name="name">Alquiler Multi-Almacén: Verificar traslados pendientes</field>
            <field name="model_id" ref="model_rental_warehouse_assignment"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_pending_transfers()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
