<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rental_availability_wizard_form" model="ir.ui.view">
        <field name="name">rental.availability.wizard.form</field>
        <field name="model">rental.availability.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultar disponibilidad de alquiler">
                <group>
                    <group>
                        <field name="product_id"/>
                        <field name="quantity_needed"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="return_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_check_availability"
                            string="Consultar disponibilidad"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary"
                            special="cancel"/>
                </footer>
                <group invisible="not result_html">
                    <field name="result_html" nolabel="1"
                           colspan="2"/>
                </group>
            </form>
        </field>
    </record>

    <record id="rental_availability_wizard_action" model="ir.actions.act_window">
        <field name="name">Consultar disponibilidad</field>
        <field name="res_model">rental.availability.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú bajo Alquiler > Informes -->
    <menuitem
        id="menu_rental_availability_wizard"
        name="Consultar disponibilidad"
        parent="sale_renting.menu_rental_report"
        action="rental_availability_wizard_action"
        sequence="10"
    />

</odoo>
