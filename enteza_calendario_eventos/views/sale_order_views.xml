<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Calendario pivotado en la fecha del evento.

        Hereda en modo `primary` del calendario nativo de alquiler
        (sale_renting.rental_order_view_calendar), que a su vez hereda del de ventas
        (sale.view_sale_order_calendar). Así este calendario es "el de alquiler, pero por
        fecha de evento": `color="rental_status"`, `edit="0"` y la sustitución de `state`
        por `rental_status` ya vienen dadas y no hay que repetirlas aquí.

        Contrapartida asumida: cualquier cambio de Odoo en el calendario de alquiler llega
        también a éste.

        Se anula `date_stop` (un `<attribute>` vacío elimina el atributo): el evento es de un
        día. Si negocio pide luego mostrar la duración completa del alquiler, basta con
        devolverle el valor `rental_return_date`.
    -->
    <record id="view_sale_order_calendar_evento" model="ir.ui.view">
        <field name="name">sale.order.calendar.evento</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_calendar"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <calendar position="attributes">
                <attribute name="string">Calendario de eventos</attribute>
                <attribute name="date_start">event_date</attribute>
                <attribute name="date_stop"/>
                <attribute name="mode">month</attribute>
                <!-- Etiqueta del evento. Sin esto el calendario usa `display_name`, que en
                     sale.order es el número de pedido. Basta el atributo: el parser mete el
                     campo en la lista de los que se leen del servidor
                     (calendar_arch_parser.js, FIELD_ATTRIBUTE_NAMES), así que no hay que
                     declararlo además como <field>. -->
                <attribute name="create_name_field">event_calendar_label</attribute>
            </calendar>

            <!-- Lugar de entrega justo debajo del cliente: es lo que pidió el cliente.
                 `groups` replica el comportamiento nativo del campo — si el ajuste
                 «Direcciones de cliente» está desactivado, desaparece del popover
                 (ver hooks.py y PRP §10.2). -->
            <field name="partner_id" position="after">
                <field name="partner_shipping_id" groups="account.group_delivery_invoice_address"/>
            </field>
        </field>
    </record>

    <record id="action_rental_event_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de eventos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('is_rental_order', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay eventos en este periodo
            </p>
            <p>
                Este calendario muestra los pedidos de alquiler por su fecha de evento,
                no por la fecha de salida del material.
            </p>
        </field>
    </record>

    <!-- Enlace explícito de la vista calendario: sin esto Odoo resolvería por prioridad y
         podría abrir el calendario nativo de alquiler en lugar de éste. -->
    <record id="action_rental_event_calendar_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_sale_order_calendar_evento"/>
        <field name="act_window_id" ref="action_rental_event_calendar"/>
    </record>

    <menuitem id="menu_rental_event_calendar"
              name="Calendario de eventos"
              parent="sale_renting.rental_order_menu"
              action="action_rental_event_calendar"
              sequence="15"/>

</odoo>
