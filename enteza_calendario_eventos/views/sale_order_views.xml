<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Calendario pivotado en la fecha del evento.

        Hereda en modo `primary` de la vista base de pedidos (sale.view_sale_order_calendar),
        igual que hace el calendario nativo de alquiler (sale_renting.rental_order_view_calendar).
        No heredamos de ese último a propósito: son dos calendarios hermanos e independientes,
        y encadenarlos haría que cualquier cambio de Odoo en el nativo arrastrase a éste.

        Sin `date_stop`: el evento es de un día. Si negocio pide luego mostrar la duración
        completa del alquiler, se añade aquí `rental_return_date`.
    -->
    <record id="view_sale_order_calendar_evento" model="ir.ui.view">
        <field name="name">sale.order.calendar.evento</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_calendar"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <calendar position="attributes">
                <attribute name="string">Calendario de eventos</attribute>
                <attribute name="date_start">event_date</attribute>
                <attribute name="color">rental_status</attribute>
                <attribute name="mode">month</attribute>
                <attribute name="edit">0</attribute>
            </calendar>

            <!-- El color pivota sobre rental_status, así que el campo tiene que estar en la
                 vista. Sustituye a `state`, que es el que colorea el calendario de ventas. -->
            <field name="state" position="replace">
                <field name="rental_status" filters="1" invisible="1"/>
            </field>

            <!-- Lugar de entrega justo debajo del cliente: es lo que pidió el cliente.
                 `groups` replica el comportamiento nativo del campo — si el ajuste
                 «Direcciones de cliente» está desactivado, desaparece del popover
                 (ver hooks.py y PRP §10.2). -->
            <field name="partner_id" position="after">
                <field name="partner_shipping_id" groups="account.group_delivery_invoice_address"/>
            </field>
        </field>
    </record>

    <record id="action_rental_event_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de eventos</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('is_rental_order', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay eventos en este periodo
            </p>
            <p>
                Este calendario muestra los pedidos de alquiler por su fecha de evento,
                no por la fecha de salida del material.
            </p>
        </field>
    </record>

    <!-- Enlace explícito de la vista calendario: sin esto Odoo resolvería por prioridad y
         podría abrir el calendario nativo de alquiler en lugar de éste. -->
    <record id="action_rental_event_calendar_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_sale_order_calendar_evento"/>
        <field name="act_window_id" ref="action_rental_event_calendar"/>
    </record>

    <menuitem id="menu_rental_event_calendar"
              name="Calendario de eventos"
              parent="sale_renting.rental_order_menu"
              action="action_rental_event_calendar"
              sequence="15"/>

</odoo>
