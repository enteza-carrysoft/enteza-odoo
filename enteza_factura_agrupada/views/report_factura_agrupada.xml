<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Informe ADICIONAL: la factura oficial de Odoo no se toca. Aparece en el desplegable
         de Imprimir de la factura, junto a la estándar. -->
    <record id="action_report_factura_agrupada" model="ir.actions.report">
        <field name="name">Factura agrupada por familias</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">enteza_factura_agrupada.report_factura_agrupada</field>
        <field name="report_file">enteza_factura_agrupada.report_factura_agrupada</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_factura_agrupada">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="enteza_factura_agrupada.report_factura_agrupada_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_factura_agrupada_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

            <!-- Cliente y lugar de entrega. Van FUERA del div.page a propósito: es donde los
                 layouts de la 19 esperan encontrarlos (`address` e `information_block`, que
                 lee `web.address_layout`). La versión anterior maquetaba el cliente por su
                 cuenta y dejaba sin rellenar `information_block` y `layout_document_title`,
                 y el layout imprimía igualmente sus huecos: de ahí el blanco entre la
                 cabecera de la empresa y los datos del cliente, y de ahí que no saliera la
                 dirección de envío. -->
            <div class="row">
                <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
                    <div class="col-6">
                        <t t-set="information_block">
                            <div name="shipping_address_block">
                                <strong class="d-block">Lugar de entrega</strong>
                                <div t-field="o.partner_shipping_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            </div>
                        </t>
                    </div>
                    <div class="col-6">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.vat">
                                <span>NIF:</span> <span t-field="o.partner_id.vat"/>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="offset-col-6 col-6">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.vat">
                                <span>NIF:</span> <span t-field="o.partner_id.vat"/>
                            </div>
                        </t>
                    </div>
                </t>
            </div>

            <div class="page" style="font-size: 10px;">
                <!-- El título lo coloca el layout, al lado de la dirección. Poniéndolo aquí
                     con nuestro propio <h2> salían dos: el nuestro y el hueco vacío del
                     layout. -->
                <t t-set="layout_document_title">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Factura borrador</span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura cancelada</span>
                    <span t-elif="o.move_type == 'out_refund'">Factura rectificativa</span>
                    <span t-elif="o.move_type == 'in_invoice'">Factura de proveedor</span>
                    <span t-elif="o.move_type == 'in_refund'">Rectificativa de proveedor</span>
                    <span t-if="o.name != '/'" t-field="o.name"/>
                </t>

                <!-- Fecha del evento: se muestra junto a la fecha de factura en el bloque de
                     datos. Sólo cuando toda la factura comparte una misma fecha. -->
                <t t-set="fecha_evento" t-value="o.enteza_fecha_evento()"/>

                <div id="informations" class="row mb-3" style="font-size: 10px;">
                    <div class="col" t-if="o.invoice_date">
                        <strong>Fecha factura:</strong>
                        <p class="m-0" t-field="o.invoice_date"/>
                    </div>
                    <div class="col" t-if="fecha_evento">
                        <strong>Fecha evento:</strong>
                        <p class="m-0" t-out="fecha_evento" t-options='{"widget": "date"}'/>
                    </div>
                    <div class="col" t-if="o.invoice_date_due and o.move_type == 'out_invoice'">
                        <strong>Vencimiento:</strong>
                        <p class="m-0" t-field="o.invoice_date_due"/>
                    </div>
                    <div class="col" t-if="o.invoice_origin">
                        <strong>Origen:</strong>
                        <p class="m-0" t-field="o.invoice_origin"/>
                    </div>
                    <div class="col" t-if="o.ref">
                        <strong>Referencia:</strong>
                        <p class="m-0" t-field="o.ref"/>
                    </div>
                </div>

                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                <t t-set="familias" t-value="o.enteza_familias_usadas()"/>
                <t t-set="sin_familia" t-value="o.enteza_lineas_sin_familia()"/>

                <table class="table table-sm o_main_table" name="tabla_lineas" style="font-size: 10px; margin-bottom: 0.5rem;">
                    <thead>
                        <tr style="line-height: 1.0;">
                            <th class="text-start" style="padding: 1px 4px;"><span>Descripción</span></th>
                            <th class="text-end" style="padding: 1px 4px;"><span>Cantidad</span></th>
                            <th class="text-end" style="padding: 1px 4px;"><span>Precio</span></th>
                            <th class="text-end" t-if="display_discount" style="padding: 1px 4px;"><span>Dto. %</span></th>
                            <th class="text-end" style="padding: 1px 4px;"><span>Importe</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="familias" t-as="familia">
                            <t t-set="lineas" t-value="o.enteza_lineas_de_familia(familia)"/>
                            <t t-if="lineas">
                                <tr>
                                    <td colspan="99" class="fw-bold"
                                        style="background:#e1e5eb; font-size: 9px; padding: 1px 4px; line-height: 1.0;">
                                        <span t-field="familia.name"/>
                                    </td>
                                </tr>
                                <tr t-foreach="lineas" t-as="line" style="line-height: 1.0;">
                                    <td class="text-start" style="padding: 1px 4px;">
                                        <span t-out="line.enteza_descripcion()"/>
                                    </td>
                                    <td class="text-end" style="padding: 1px 4px;">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                    </td>
                                    <td class="text-end" style="padding: 1px 4px;">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td class="text-end" t-if="display_discount" style="padding: 1px 4px;">
                                        <span t-field="line.discount"/>
                                    </td>
                                    <td class="text-end" style="padding: 1px 4px;">
                                        <span t-field="line.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </t>

                        <!-- Líneas sin familia: se imprimen igualmente para que no se pierda
                             ningún importe de la factura. -->
                        <t t-if="sin_familia">
                            <tr>
                                <td colspan="99" class="fw-bold"
                                    style="background:#e1e5eb; font-size: 9px; padding: 1px 4px; line-height: 1.0;">
                                    <span>Otros conceptos</span>
                                </td>
                            </tr>
                            <tr t-foreach="sin_familia" t-as="line" style="line-height: 1.0;">
                                <td class="text-start" style="padding: 1px 4px;">
                                    <span t-out="line.enteza_descripcion()"/>
                                </td>
                                <td class="text-end" style="padding: 1px 4px;">
                                    <span t-field="line.quantity"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                                <td class="text-end" style="padding: 1px 4px;"><span t-field="line.price_unit"/></td>
                                <td class="text-end" t-if="display_discount" style="padding: 1px 4px;">
                                    <span t-field="line.discount"/>
                                </td>
                                <td class="text-end" style="padding: 1px 4px;">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Los impuestos salen aquí y no en las líneas: aquí todo se vende al mismo
                     tipo, así que repetirlo 60 veces sólo gastaba ancho de papel. Van
                     agrupados por porcentaje, de modo que «21% G» y «21% S» —el mismo 21 % en
                     dos cuentas distintas— salen en un solo renglón. -->
                <t t-set="impuestos" t-value="o.enteza_impuestos_agrupados()"/>
                <t t-set="imp_size" t-value="len(impuestos)"/>

                <div class="clearfix">
                    <div id="total" class="row justify-content-end">
                        <div class="col-5">
                            <table class="table table-sm" style="font-size: 10px; margin-bottom: 0;">
                                <tr style="line-height: 1.0;">
                                    <td style="padding: 1px 4px;"><strong>Base imponible</strong></td>
                                    <td class="text-end" style="padding: 1px 4px;">
                                        <span t-field="o.amount_untaxed"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-foreach="impuestos" t-as="imp" style="line-height: 1.0;">
                                    <td style="padding: 1px 4px;">
                                        <span t-out="imp['etiqueta']"/>
                                        <!-- La base sólo se detalla cuando hay más de un tipo:
                                             con uno solo sería repetir la de arriba. -->
                                        <span t-if="imp_size > 1" class="text-muted small">
                                            s/ <span t-out="imp['base']"
                                                     t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </span>
                                    </td>
                                    <td class="text-end" style="padding: 1px 4px;">
                                        <span t-out="imp['importe']"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <!-- Red de seguridad: si por lo que sea no se pudo agrupar,
                                     el importe de impuestos no desaparece del papel. -->
                                <tr t-if="not impuestos and o.amount_tax" style="line-height: 1.0;">
                                    <td style="padding: 1px 4px;">Impuestos</td>
                                    <td class="text-end" style="padding: 1px 4px;">
                                        <span t-field="o.amount_tax"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="border-black o_total" style="line-height: 1.0;">
                                    <td style="padding: 1px 4px;"><strong>Total</strong></td>
                                    <td class="text-end" style="padding: 1px 4px;">
                                        <strong t-field="o.amount_total"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <p t-if="o.narration" name="comment">
                    <span t-field="o.narration"/>
                </p>
                <p t-if="o.invoice_payment_term_id" name="payment_term">
                    <span t-field="o.invoice_payment_term_id.note"/>
                </p>
            </div>
        </t>
    </template>

</odoo>
