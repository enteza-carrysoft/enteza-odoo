<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_enteza_stock_deficit_list" model="ir.ui.view">
        <field name="name">enteza.stock.deficit.list</field>
        <field name="model">enteza.stock.deficit</field>
        <field name="arch" type="xml">
            <!--
                Rojo cuando no hay quien lo cubra: es lo único de esta lista que exige una
                decisión de negocio (subcontratar, cambiar de artículo, renegociar la fecha).
                Lo demás se resuelve con un préstamo.
            -->
            <list decoration-danger="qty_sin_cubrir &gt; 0"
                  decoration-warning="qty_sin_cubrir == 0">
                <field name="date_from"/>
                <field name="date_to" optional="hide"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="qty_deficit" sum="Falta"/>
                <field name="warehouse_src_id" string="Puede prestarlo"/>
                <field name="qty_cubrible" sum="Prestable"/>
                <field name="qty_sin_cubrir" sum="Sin cubrir"/>
                <field name="order_ids" widget="many2many_tags" optional="show"/>
                <field name="date_analisis" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_enteza_stock_deficit_search" model="ir.ui.view">
        <field name="name">enteza.stock.deficit.search</field>
        <field name="model">enteza.stock.deficit</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <filter name="f_sin_cubrir" string="Sin solución"
                        domain="[('qty_sin_cubrir', '&gt;', 0)]"/>
                <filter name="f_cubrible" string="Se pueden pedir prestadas"
                        domain="[('qty_cubrible', '&gt;', 0)]"/>
                <!-- `<group>` a secas: en la 19 no admite `expand` ni `string`. Ver
                     `convenciones-modulo.md` del skill. -->
                <group>
                    <filter name="g_producto" string="Producto"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="g_almacen" string="Almacén"
                            context="{'group_by': 'warehouse_id'}"/>
                    <filter name="g_fecha" string="Fecha"
                            context="{'group_by': 'date_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_enteza_stock_deficit" model="ir.actions.act_window">
        <field name="name">Material que faltará</field>
        <field name="res_model">enteza.stock.deficit</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No falta material en el horizonte analizado</p>
            <p>
                Aquí aparece lo que los pedidos ya confirmados no van a poder servir, y qué
                compañía del grupo puede prestarlo. Se recalcula solo cada noche.
            </p>
        </field>
    </record>

    <record id="action_enteza_analizar_deficit" model="ir.actions.server">
        <field name="name">Analizar ahora</field>
        <field name="model_id" ref="model_enteza_stock_deficit"/>
        <field name="state">code</field>
        <field name="code">action = model.action_analizar_ahora()</field>
    </record>

    <record id="action_enteza_proponer_prestamos" model="ir.actions.server">
        <field name="name">Proponer préstamos</field>
        <field name="model_id" ref="model_enteza_stock_deficit"/>
        <field name="binding_model_id" ref="model_enteza_stock_deficit"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_proponer_prestamos()</field>
    </record>

    <menuitem id="menu_enteza_stock_deficit"
              name="Material que faltará"
              parent="menu_enteza_prestamo_root"
              action="action_enteza_stock_deficit"
              sequence="20"/>

    <menuitem id="menu_enteza_analizar_deficit"
              name="Analizar ahora"
              parent="menu_enteza_prestamo_root"
              action="action_enteza_analizar_deficit"
              sequence="30"
              groups="enteza_prestamo_intercompania.group_prestamo_responsable"/>

</odoo>
