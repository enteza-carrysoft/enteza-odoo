<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        🔴 Ubicación de tránsito entre compañías.

        NO se crea: Odoo 19 ya trae `stock.stock_location_inter_company`, con
        `usage='transit'` y `company_id` vacío, que es justo lo que hace falta. Lo único que
        pasa es que viene **archivada**, y por eso una búsqueda de ubicaciones de tránsito no
        la encuentra y parece que no existe (el §2 del PRP llegó a anotar «0 ubicaciones de
        tránsito en toda la base»).

        Crear una propia sería duplicar la que usan los flujos intercompañía del propio Odoo.
        Aquí solo se reactiva.

        Va FUERA del bloque `noupdate="1"` a propósito: si alguien la archiva, la siguiente
        actualización del módulo la vuelve a dejar utilizable.
    -->
    <record id="stock.stock_location_inter_company" model="stock.location">
        <field name="active" eval="True"/>
    </record>

    <data noupdate="1">

        <!--
            Secuencia sin compañía (`company_id` vacío) a propósito.

            Un préstamo lo ve y lo trabaja gente de las DOS sociedades, y una numeración por
            compañía haría que el mismo documento se llamara distinto según quién lo mire, o
            que hubiera dos PRE/2026/00001. Con una sola serie compartida la referencia es
            única y sirve para hablar por teléfono entre los dos almacenes, que es para lo
            que se usa de verdad.
        -->
        <record id="seq_enteza_stock_loan" model="ir.sequence">
            <field name="name">Préstamo entre compañías</field>
            <field name="code">enteza.stock.loan</field>
            <field name="prefix">PRE/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!--
            Parámetros de configuración (PRP §8).

            Van en `ir.config_parameter` y no en `res.config.settings`: son tres valores que
            hoy nadie va a tocar a diario, y una página de ajustes propia obligaría a
            depender de `base_setup` y a mantener una vista más. Se leen con
            `_parametro()`, que aplica el valor por defecto si el registro no existe, así
            que borrarlos no rompe nada.

            `noupdate="1"`: si el cliente los cambia, una actualización del módulo no debe
            devolverlos a su valor de fábrica.
        -->
        <record id="param_dias_antelacion" model="ir.config_parameter">
            <field name="key">enteza_prestamo.dias_antelacion_traslado</field>
            <field name="value">3</field>
        </record>

        <record id="param_horizonte_analisis" model="ir.config_parameter">
            <field name="key">enteza_prestamo.horizonte_analisis</field>
            <field name="value">30</field>
        </record>

        <record id="param_ventana_retencion" model="ir.config_parameter">
            <field name="key">enteza_prestamo.ventana_retencion</field>
            <field name="value">7</field>
        </record>

        <!--
            Cron del análisis por lotes (§7.1). De madrugada porque recorre toda la demanda
            confirmada del horizonte y no tiene ninguna prisa: su valor está en que la lista
            esté al día cuando el responsable la mire por la mañana.

            🔴 NO crea préstamos ni mueve nada. Solo analiza.
        -->
        <record id="cron_analisis_deficit" model="ir.cron">
            <field name="name">Préstamos: analizar el material que faltará</field>
            <field name="model_id" ref="model_enteza_stock_deficit"/>
            <field name="state">code</field>
            <field name="code">model._cron_analizar()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
