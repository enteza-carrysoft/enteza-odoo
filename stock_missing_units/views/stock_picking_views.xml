<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_done']" position="before">
                <field name="missing_units"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_stock_move_line_form_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.form.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_done']" position="before">
                <field name="missing_units"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_stock_move_operations_inherit" model="ir.ui.view">
        <field name="name">stock.move.operations.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_line_ids']/tree//field[@name='qty_done']" position="before">
                <field name="missing_units"/>
            </xpath>
        </field>
    </record>
</odoo>
