<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="enteza_panel_eventos.PanelEventos">
        <div class="o_enteza_panel o_action d-flex flex-column h-100">

            <!-- Barra superior -->
            <div class="o_enteza_panel_barra d-flex align-items-center gap-2 p-2 border-bottom flex-wrap">
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.cambiarMes(-1)">
                    <i class="oi oi-chevron-left"/>
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.cambiarMes(1)">
                    <i class="oi oi-chevron-right"/>
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="irAHoy">Hoy</button>
                <span class="o_enteza_panel_mes fw-bold ms-2" t-esc="nombreMes"/>

                <!--
                    Los tres días de un pedido. Como la salida es la víspera del evento y la
                    devolución el día siguiente, los tres contadores casi nunca coinciden: se
                    enseñan siempre para que se vea de un vistazo el trabajo real del día.
                -->
                <div class="btn-group btn-group-sm ms-3" role="group">
                    <button t-foreach="modos" t-as="modoDisponible" t-key="modoDisponible.clave"
                            class="btn"
                            t-att-class="state.modo === modoDisponible.clave ? 'btn-primary' : 'btn-outline-primary'"
                            t-on-click="() => this.cambiarModo(modoDisponible.clave)">
                        <t t-esc="modoDisponible.etiqueta"/>
                        <span class="badge text-bg-light ms-1"
                              t-esc="state.contadores[modoDisponible.clave]"/>
                    </button>
                </div>

                <!--
                    Un presupuesto sin confirmar todavía puede no ocurrir. Se ve por defecto
                    —hay que saber que está ahí— pero desde aquí se quita del material, de la
                    sobreventa y del parte que baja al almacén.
                -->
                <div class="form-check form-switch ms-3 mb-0"
                     title="Deja fuera los presupuestos sin confirmar: material, sobreventa y parte del día">
                    <input class="form-check-input" type="checkbox" id="o_enteza_solo_confirmados"
                           t-att-checked="state.soloConfirmados"
                           t-on-change="alternarSoloConfirmados"/>
                    <label class="form-check-label small" for="o_enteza_solo_confirmados">
                        Solo confirmados
                        <span t-if="!state.soloConfirmados &amp;&amp; state.totales.borradores"
                              class="badge text-bg-warning ms-1"
                              t-esc="state.totales.borradores"/>
                    </label>
                </div>

                <div class="flex-grow-1"/>
                <span t-if="state.cargando" class="text-muted small">
                    <i class="fa fa-circle-o-notch fa-spin me-1"/>Cargando…
                </span>
                <span class="text-muted">
                    <t t-esc="state.totales.pedidos"/> pedidos ·
                    <t t-esc="state.totales.importe"/>
                </span>
                <button class="btn btn-secondary btn-sm" t-on-click="imprimirParte">
                    <i class="fa fa-print me-1"/>Parte del día
                </button>
                <button class="btn btn-primary btn-sm" t-on-click="verPedidosDelDia">
                    Ver en lista
                </button>
            </div>

            <!--
                Un error de RPC dejaba la pantalla en blanco sin decir nada, y el panel se usa
                desde el almacén: allí nadie va a abrir la consola del navegador.
            -->
            <div t-if="state.error" class="alert alert-danger m-2 mb-0" role="alert">
                <strong>No se han podido cargar los datos.</strong>
                <div class="small" t-esc="state.error"/>
            </div>

            <div class="o_enteza_panel_cuerpo d-flex flex-grow-1 overflow-auto"
                 t-att-class="{ 'o_enteza_cargando': state.cargando }">

                <!-- Bloque 1: calendario mensual -->
                <div class="o_enteza_panel_calendario p-2 border-end">
                    <div class="o_enteza_rejilla">
                        <div t-foreach="diasSemana" t-as="nombreDia" t-key="nombreDia_index"
                             class="o_enteza_cabecera_dia" t-esc="nombreDia"/>
                        <t t-foreach="celdas" t-as="celda" t-key="celda_index">
                            <div t-if="!celda" class="o_enteza_celda o_enteza_celda_vacia"/>
                            <div t-else=""
                                 class="o_enteza_celda"
                                 t-att-class="{
                                     'o_enteza_nivel_1': celda.nivel === 1,
                                     'o_enteza_nivel_2': celda.nivel === 2,
                                     'o_enteza_nivel_3': celda.nivel === 3,
                                     'o_enteza_nivel_4': celda.nivel === 4,
                                     'o_enteza_hoy': celda.esHoy,
                                     'o_enteza_seleccionado': celda.seleccionado,
                                 }"
                                 t-att-title="celda.titulo"
                                 t-on-click="() => this.seleccionarDia(celda.clave)">
                                <span t-esc="celda.dia"/>
                                <span t-if="celda.pedidos" class="o_enteza_contador"
                                      t-esc="celda.pedidos"/>
                            </div>
                        </t>
                    </div>
                    <!-- Cortes medidos sobre la carga real: ver CORTES_CARGA en el JS. -->
                    <div class="o_enteza_leyenda mt-2 small text-muted">
                        <span class="o_enteza_muestra o_enteza_nivel_1"/> 1-2
                        <span class="o_enteza_muestra o_enteza_nivel_2"/> 3-9
                        <span class="o_enteza_muestra o_enteza_nivel_3"/> 10-29
                        <span class="o_enteza_muestra o_enteza_nivel_4"/> 30+
                    </div>
                </div>

                <!-- Bloque 2: material del día -->
                <div class="o_enteza_panel_material flex-grow-1 d-flex flex-column p-2 overflow-auto">

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="o_enteza_titulo mb-0" t-esc="tituloMaterial"/>

                        <input type="text" class="form-control form-control-sm o_enteza_filtro"
                               placeholder="Filtro por descripción"
                               t-att-value="state.filtroArticulo"
                               t-on-input="alFiltrarArticulos"/>

                        <!--
                            Las dos vistas de la aplicación anterior. «Sobre venta» deja solo
                            el material del que hay comprometido más de lo que hay en el
                            almacén: es la lista de lo que habría que comprar o subcontratar.
                        -->
                        <div class="btn-group btn-group-sm" role="group">
                            <button class="btn"
                                    t-att-class="state.vistaMaterial === 'consumos' ? 'btn-secondary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.cambiarVistaMaterial('consumos')">
                                Consumos
                            </button>
                            <button class="btn"
                                    t-att-class="state.vistaMaterial === 'sobreventa' ? 'btn-danger' : 'btn-outline-danger'"
                                    t-on-click="() => this.cambiarVistaMaterial('sobreventa')">
                                Sobre venta
                                <span t-if="state.totales.sobreventa" class="badge text-bg-light ms-1"
                                      t-esc="state.totales.sobreventa"/>
                            </button>
                        </div>

                        <span class="text-muted small ms-auto">
                            <t t-esc="articulosVisibles.length"/> de
                            <t t-esc="state.articulos.length"/> artículos ·
                            <t t-esc="unidadesVisibles"/> unidades
                        </span>
                    </div>

                    <table class="table table-sm table-hover mt-2">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th>Clasificación</th>
                                <!-- Solo si el día mezcla almacenes: con uno repetiría el
                                     mismo valor en todas las filas. -->
                                <th t-if="mostrarAlmacen">Almacén</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Existencias</th>
                                <th class="text-end">Prestados</th>
                                <th class="text-end">Faltan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Pinchar un artículo filtra los pedidos de abajo a los que lo
                                 llevan; volver a pincharlo quita el filtro. -->
                            <tr t-foreach="articulosVisibles" t-as="articulo" t-key="articulo.clave"
                                class="o_enteza_fila_articulo"
                                t-att-class="{
                                    'o_enteza_sobreventa': articulo.sobreventa,
                                    'table-active': state.articuloSeleccionado === articulo.clave,
                                }"
                                t-on-click="() => this.seleccionarArticulo(articulo.clave)">
                                <td t-esc="articulo.articulo"/>
                                <td class="text-muted" t-esc="articulo.categoria"/>
                                <td t-if="mostrarAlmacen" class="text-muted" t-esc="articulo.almacen"/>
                                <td class="text-end fw-bold" t-esc="articulo.unidades"/>
                                <td class="text-end" t-esc="articulo.existencias"/>
                                <td class="text-end" t-esc="articulo.prestado"/>
                                <td class="text-end fw-bold">
                                    <t t-if="articulo.sobreventa" t-esc="articulo.faltan"/>
                                </td>
                            </tr>
                            <tr t-if="!articulosVisibles.length">
                                <td t-att-colspan="columnasMaterial" class="text-center text-muted p-3">
                                    <t t-if="!state.articulos.length">
                                        Sin material para este día
                                    </t>
                                    <t t-elif="state.vistaMaterial === 'sobreventa'">
                                        No falta material para este día
                                    </t>
                                    <t t-else="">
                                        Ningún artículo coincide con el filtro
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Bloque 3: pedidos del día -->
            <div class="o_enteza_panel_pedidos border-top p-2 overflow-auto"
                 t-att-class="{ 'o_enteza_cargando': state.cargando }">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="o_enteza_titulo mb-0">Pedidos del día</h5>
                    <!-- Filtro activo por artículo: se ve siempre y se quita desde aquí, para
                         que nadie lea una lista corta creyendo que es el día entero. -->
                    <span t-if="articuloActivo" class="badge text-bg-primary">
                        <t t-esc="articuloActivo.articulo"/>
                        <t t-if="mostrarAlmacen">
                            · <t t-esc="articuloActivo.almacen"/>
                        </t>
                        <span class="ms-2 o_enteza_quitar_filtro"
                              t-on-click="quitarFiltroArticulo">✕</span>
                    </span>
                    <span t-if="articuloActivo" class="text-muted small">
                        <t t-esc="pedidosVisibles.length"/> de
                        <t t-esc="state.pedidos.length"/> pedidos
                    </span>
                </div>
                <table class="table table-sm table-hover mt-2">
                    <thead>
                        <tr>
                            <th>Nº</th>
                            <th>Cliente</th>
                            <th>Lugar de entrega</th>
                            <th t-if="mostrarAlmacen">Almacén</th>
                            <th>Comercial</th>
                            <th t-if="state.modo !== 'evento'">Evento</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Estado</th>
                            <!-- Cuántas unidades del artículo pinchado lleva cada pedido: es
                                 la pregunta que viene justo después de «quién lo lleva». -->
                            <th t-if="articuloActivo" class="text-end">Uds.</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="pedidosVisibles" t-as="pedido" t-key="pedido.id"
                            class="o_enteza_fila_pedido"
                            t-att-class="{ 'o_enteza_sin_confirmar': !pedido.confirmado }"
                            t-on-click="() => this.abrirPedido(pedido.id)">
                            <td>
                                <t t-esc="pedido.nombre"/>
                                <!-- `note` es el campo de términos y condiciones y casi ningún
                                     pedido lo tiene: no merece una columna, sí un indicador. -->
                                <i t-if="pedido.notas" class="fa fa-sticky-note-o ms-1 text-muted"
                                   t-att-title="pedido.notas"/>
                            </td>
                            <td t-esc="pedido.cliente"/>
                            <td class="text-muted" t-esc="pedido.lugar"/>
                            <td t-if="mostrarAlmacen" class="text-muted" t-esc="pedido.almacen"/>
                            <td class="text-muted" t-esc="pedido.comercial"/>
                            <td t-if="state.modo !== 'evento'" t-esc="pedido.evento"/>
                            <td t-esc="pedido.inicio"/>
                            <td t-esc="pedido.fin"/>
                            <td>
                                <span t-if="!pedido.confirmado" class="badge text-bg-warning me-1"
                                      title="Presupuesto sin confirmar: este material todavía puede no salir">
                                    Presupuesto
                                </span>
                                <t t-esc="pedido.estado"/>
                            </td>
                            <td t-if="articuloActivo" class="text-end fw-bold"
                                t-esc="unidadesDelPedido(pedido)"/>
                            <td class="text-end" t-esc="pedido.importe"/>
                        </tr>
                        <tr t-if="!pedidosVisibles.length">
                            <td t-att-colspan="columnasPedidos" class="text-center text-muted p-3">
                                <t t-if="articuloActivo">
                                    Ningún pedido de este día lleva ese artículo
                                </t>
                                <t t-else="">
                                    No hay eventos este día
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

</templates>
