<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Botón "Descuento" entre las líneas de factura y los totales, igual que en el
         pedido de venta (sale.order_views.xml, div "so_button_below_order_lines"). Solo
         para facturas de cliente (out_invoice/out_refund) en borrador: una vez validada,
         la línea contable ya no se puede tocar así. -->
    <record id="view_move_form_discount" model="ir.ui.view">
        <field name="name">account.move.form.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="before">
                <div class="float-end d-flex d-print-none gap-1 mb-2"
                     name="account_move_button_below_lines"
                     invisible="move_type not in ('out_invoice', 'out_refund') or state != 'draft'">
                    <button string="Descuento"
                            name="action_open_discount_wizard"
                            type="object"
                            class="btn btn-secondary"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
