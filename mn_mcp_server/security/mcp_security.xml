<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_mcp_user" model="res.groups">
            <field name="name">MCP / User</field>
        </record>
        <record id="group_mcp_manager" model="res.groups">
            <field name="name">MCP / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        </record>

        <record id="rule_apikey_own" model="ir.rule">
            <field name="name">API key — own keys</field>
            <field name="model_id" ref="model_mn_mcp_api_key"/>
            <field name="domain_force">['|',('user_id','=',user.id),('user_id.id','in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        </record>
        <record id="rule_apikey_admin" model="ir.rule">
            <field name="name">API key — manager sees all</field>
            <field name="model_id" ref="model_mn_mcp_api_key"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_manager'))]"/>
        </record>
    </data>

    <!-- Not noupdate: also applies on upgrade so existing installs are fixed.
         Give every Odoo Settings administrator the MCP Manager group, so the
         MCP Server app menu and all its configuration screens are visible and
         usable out of the box (otherwise nobody is in the group on install). -->
    <data>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mcp_manager'))]"/>
        </record>
    </data>
</odoo>
