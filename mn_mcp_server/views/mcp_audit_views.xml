<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_audit" model="ir.actions.act_window">
            <field name="name">Audit Log</field>
            <field name="res_model">mn.mcp.audit</field>
            <field name="view_mode">list</field>
        </record>
        <record id="view_audit_list" model="ir.ui.view">
            <field name="name">mn.mcp.audit.list</field>
            <field name="model">mn.mcp.audit</field>
            <field name="arch" type="xml">
                <list decoration-danger="status in ('auth_fail','forbidden','error')"
                      decoration-warning="status == 'over_quota'"
                      decoration-success="status == 'ok'">
                    <field name="create_date"/>
                    <field name="api_key_id"/>
                    <field name="user_id"/>
                    <field name="method"/>
                    <field name="model_target"/>
                    <field name="latency_ms"/>
                    <field name="ip"/>
                    <field name="status" widget="badge"/>
                    <field name="error_msg" optional="show"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
