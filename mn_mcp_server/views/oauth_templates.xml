<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The consent screen. Deliberately plain and specific: a user should be
         able to read exactly which system is asking, as whom they will act,
         and what it will be able to do.

         Built on web.layout, not web.frontend_layout: the latter reaches for
         the website module's rendering context and 500s on an install that
         does not have it. This module must run anywhere Odoo runs. -->
    <template id="oauth_consent" name="MCP: authorise application">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'en-US'}"/>
            <div style="font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                        background:#0F1117;min-height:100vh;margin:0;padding:60px 20px;">
                <div style="max-width:520px;margin:0 auto;background:#FFFFFF;
                            border-radius:14px;padding:32px;
                            box-shadow:0 10px 40px rgba(0,0,0,.35);">

                    <div style="font-size:11px;letter-spacing:.22em;text-transform:uppercase;
                                color:#8B5CF6;font-weight:700;margin-bottom:10px;">
                        Authorise application
                    </div>

                    <h2 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#0F1117;">
                        <span t-field="client.name"/> wants to connect to Odoo
                    </h2>

                    <p style="color:#475569;line-height:1.7;margin:0 0 20px;">
                        It will act as <b t-field="user.name"/>
                        (<span t-field="user.login"/>) and can only see and do what
                        that account is already allowed to.
                    </p>

                    <div style="border:1px solid #E2E8F0;border-radius:10px;
                                padding:16px 18px;margin-bottom:18px;">
                        <div style="font-weight:700;margin-bottom:10px;color:#0F1117;">
                            This will allow it to:
                        </div>
                        <ul style="margin:0;padding-left:20px;color:#475569;line-height:1.9;">
                            <li t-if="'odoo:read' in scope">Read records you can read</li>
                            <li t-if="'odoo:write' in scope">
                                Create and update records you can edit
                            </li>
                            <li t-if="'odoo:admin' in scope" style="color:#DC2626;">
                                Delete records you can delete
                            </li>
                        </ul>
                    </div>

                    <div style="font-size:12px;color:#94A3B8;margin-bottom:20px;
                                word-break:break-all;">
                        Requested by <span t-field="client.client_id"/>
                    </div>

                    <form method="post" action="/mcp/oauth/authorize">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>
                        <t t-foreach="params.items()" t-as="param">
                            <input type="hidden" t-att-name="param[0]"
                                   t-att-value="param[1]"/>
                        </t>
                        <button type="submit" name="decision" value="allow"
                                style="width:100%;background:#8B5CF6;color:#fff;border:none;
                                       border-radius:9px;padding:13px;font-size:15px;
                                       font-weight:700;cursor:pointer;margin-bottom:10px;">
                            Allow
                        </button>
                        <button type="submit" name="decision" value="deny"
                                style="width:100%;background:#F1F5F9;color:#334155;
                                       border:none;border-radius:9px;padding:13px;
                                       font-size:15px;cursor:pointer;">
                            Deny
                        </button>
                    </form>
                </div>

                <div style="text-align:center;color:#64748B;font-size:12px;margin-top:18px;">
                    You can revoke this at any time in Odoo under
                    MCP Server &#8250; OAuth Clients.
                </div>
            </div>
        </t>
    </template>

</odoo>
