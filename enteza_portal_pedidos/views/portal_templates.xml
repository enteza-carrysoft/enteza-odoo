<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        🔴 Parche a una plantilla NATIVA de Odoo, no de este módulo.

        `portal.language_selector` (fichero `portal/views/portal_templates.xml` del core)
        hace `len(frontend_languages) > 1` sin protegerse de que `frontend_languages` no
        exista. Esa variable la rellena normalmente el módulo `website` (selector de idioma
        del sitio público); como aquí NO se instala `website` a propósito (PRP §2.1), la
        variable nunca se crea y `len(None)` revienta con un 500 real, verificado contra
        `enteza26` el 2026-08-08 al abrir `/my/solicitudes`:

            TypeError: object of type 'NoneType' has no len()
            Template: portal.language_selector · Reference: 586

        No es un fallo de este módulo: cualquier página del portal que llegue al pie de
        `portal.frontend_layout` lo dispara igual (`/my/orders`, `/my/invoices`...), lo que
        pasa es que nadie las había visitado como cliente portal hasta ahora. El propio Odoo
        reconoce el patrón como frágil: lo eliminó más adelante moviendo el selector a
        `website` (https://github.com/odoo/odoo/pull/113795).

        El parche es mínimo: `frontend_languages or []` en vez de `frontend_languages` a
        secas. Con una sola lengua activa (`es_ES`), el resultado correcto es igual de todas
        formas: `len([]) > 1` es `False`, el selector no se muestra.
    -->
    <template id="portal_language_selector_fix" inherit_id="portal.language_selector">
        <xpath expr="//t[@t-set='language_selector_visible']" position="attributes">
            <attribute name="t-value">len(frontend_languages or []) > 1</attribute>
        </xpath>
    </template>

    <!--
        Tarjeta en la portada de «Mi cuenta» (PRP §9). Solo si `enteza_portal_pedidos_ok`
        (PRP §12.1: es la puerta del módulo). Markup propio, sin depender de
        `portal.portal_docs_entry`: su contrato de parámetros exactos no está verificado
        contra `enteza26`, y el contenedor `o_portal_docs` sí es un anclaje estable de sobra
        conocido — es más seguro montar la tarjeta a mano que arriesgar una llamada a un
        sub-template cuyo `t-set` esperado no se puede confirmar sin la instancia.
    -->
    <template id="portal_my_home_solicitudes" name="Solicitudes en Mi cuenta"
              inherit_id="portal.portal_my_home" customize_show="True" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="enteza_portal_pedidos_ok">
                <div class="col-lg-3 col-md-4 col-6 mb-2">
                    <a href="/my/solicitudes"
                       class="o_portal_docs_entry d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none h-100">
                        <i class="fa fa-3x fa-shopping-cart mb-2" role="img"
                           aria-label="Solicitudes" title="Solicitudes"/>
                        <span>Solicitudes de pedido</span>
                        <t t-if="solicitud_count">
                            <span class="badge text-bg-primary mt-1" t-esc="solicitud_count"/>
                        </t>
                    </a>
                </div>
            </t>
        </xpath>
    </template>

    <!--
        Aviso cuando el cliente no tiene almacén habitual configurado (PRP v2 D3): el
        almacén ya NO se elige desde el portal -Sevilla es Vimaple y Jerez es Stileum, y
        dejar que el cliente salte de sociedad sin que nadie lo decida era el defecto §5.8
        del diseño anterior-. Sin este dato en su ficha, no se crea ninguna solicitud
        huérfana: se le pide que hable con su comercial.
    -->
    <template id="portal_sin_almacen" name="Sin almacén asignado">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="alert alert-info">
                <h4 class="alert-heading">Todavía no puedes montar una solicitud</h4>
                <p>
                    Antes de que puedas pedir material desde aquí, tu comercial tiene que
                    indicar desde qué almacén se te sirve habitualmente.
                </p>
                <p class="mb-0">Contacta con tu comercial y vuelve a intentarlo.</p>
            </div>
        </t>
    </template>

    <!--
        Lista de solicitudes (PRP §8.1, §9.4). Mismo idioma que las páginas nativas del
        portal (`portal.portal_table` + `portal.pager`), para que se sienta parte del mismo
        sitio y no un módulo aparte.
    -->
    <template id="portal_my_solicitudes" name="Mis solicitudes de pedido">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Mis solicitudes de pedido</h2>
                <a href="/my/solicitud/nueva" class="btn btn-primary">
                    <i class="fa fa-plus me-1"/> Nueva solicitud
                </a>
            </div>

            <t t-if="not solicitudes">
                <p class="text-muted">Todavía no has enviado ninguna solicitud.</p>
            </t>

            <t t-if="solicitudes" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Referencia</th>
                        <th>Fecha del evento</th>
                        <th>Enviada</th>
                        <th class="text-end">Importe</th>
                        <th class="text-end">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="solicitudes" t-as="solicitud">
                        <tr>
                            <td>
                                <a t-attf-href="/my/solicitud/#{solicitud.id}#{'/resumen' if solicitud.enteza_portal_state != 'composing' else ''}">
                                    <t t-esc="solicitud.enteza_portal_ref or solicitud.name"/>
                                </a>
                            </td>
                            <td><span t-field="solicitud.event_date"/></td>
                            <td><span t-field="solicitud.enteza_portal_submitted_on"/></td>
                            <td class="text-end"><span t-field="solicitud.amount_total"/></td>
                            <td class="text-end">
                                <t t-esc="estados_portal.get(solicitud.enteza_portal_state)"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>

            <t t-if="pager">
                <div class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>

            <!-- Repetir un pedido anterior (PRP §9.4): copia las líneas con fechas vacías.
                 PRP v2 §F3: si ya hay una solicitud en composición, esto REEMPLAZA su
                 contenido -de ahí la confirmación antes de enviar el formulario. -->
            <t t-if="pedidos_repetibles">
                <h3 class="mt-4">Repetir un pedido anterior</h3>
                <div class="row">
                    <t t-foreach="pedidos_repetibles" t-as="pedido">
                        <div class="col-md-4 mb-2">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title" t-esc="pedido.name"/>
                                    <p class="card-text text-muted">
                                        <span t-field="pedido.event_date"/>
                                    </p>
                                    <form t-attf-action="/my/solicitudes/#{pedido.id}/repetir"
                                          method="post" class="mt-auto"
                                          onsubmit="return confirm('Si ya tienes una solicitud a medio montar, esto reemplazará sus líneas por las de este pedido. ¿Continuar?');">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                                            Repetir este pedido
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!--
        Pantalla de edición (PRP §9). Solo monta el punto de anclaje del componente OWL: el
        `orderId` viaja por un `<script type="application/json">` con un entero sin escapar
        (nada que pueda romper el JSON), no por el mecanismo de `props` de `owl-component`
        -cuyo contrato exacto de serialización no está verificado contra esta instancia- ni
        por parámetros en la URL que un componente tendría que volver a parsear.
    -->
    <template id="portal_solicitud_grid" name="Solicitud de pedido">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <script type="application/json" id="enteza_portal_pedidos_data">{"orderId": <t t-esc="order.id"/>}</script>
            <owl-component name="enteza_portal_pedidos.RequestGrid" class="d-block"/>
        </t>
    </template>

    <!--
        Resumen + diff de contrapropuesta (PRP §11) + diálogo cliente-comercial (PRP v2 §8).
        Estático: se renderiza en QWeb del lado servidor, no en OWL -el diálogo no necesita
        la reactividad de la rejilla, y montar otro componente OWL solo para esto habría
        sido peso sin beneficio.

        🔴 Renderizado propio, no `portal.message_thread` (existe en la instancia, `ir.ui.view`
        id 606, pero su contrato de `t-set` no está verificado contra `enteza26`, y un
        `t-call` mal parametrizado es un 500 en la página — mismo criterio que
        `portal.portal_docs_entry` más arriba).
    -->
    <template id="portal_solicitud_resumen" name="Resumen de la solicitud">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">
                    <t t-esc="order.enteza_portal_ref or order.name"/>
                </h2>
                <span class="badge text-bg-secondary">
                    <t t-esc="estados_portal.get(order.enteza_portal_state)"/>
                </span>
            </div>

            <t t-if="error_dialogo">
                <div class="alert alert-danger" t-esc="error_dialogo"/>
            </t>

            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>Datos del evento</h5>
                    <ul class="list-unstyled">
                        <li>Fecha del evento: <span t-field="order.event_date"/></li>
                        <li>Entrega: <span t-field="order.rental_start_date"/></li>
                        <li>Retirada: <span t-field="order.rental_return_date"/></li>
                        <li>Almacén: <t t-esc="order.warehouse_id.name"/></li>
                        <li>Líneas: <t t-esc="order.enteza_portal_line_count"/></li>
                        <li>Importe (sin IVA): <span t-field="order.amount_untaxed"/></li>
                    </ul>
                    <t t-if="order.enteza_portal_customer_note">
                        <p>
                            <strong>Tu comentario:</strong><br/>
                            <t t-esc="order.enteza_portal_customer_note"/>
                        </p>
                    </t>
                </div>
                <div class="col-md-6">
                    <h5>Seguimiento</h5>
                    <ul class="list-unstyled">
                        <t t-foreach="timeline" t-as="paso">
                            <li>
                                <a t-att-href="paso['url']" t-esc="paso['label']"/>
                            </li>
                        </t>
                    </ul>
                </div>
            </div>

            <t t-if="diff_rows">
                <h5>Lo que propone el comercial</h5>
                <p class="text-muted">
                    En rojo lo que se ha quitado, en amarillo lo que ha cambiado de
                    cantidad, en verde lo que se ha añadido.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Artículo</th>
                                <th class="text-end">Solicitaste</th>
                                <th class="text-end">Te proponemos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="diff_rows" t-as="fila">
                                <tr t-attf-class="{{ 'table-warning' if fila['state'] == 'changed' else ('table-danger' if fila['state'] == 'removed' else ('table-success' if fila['state'] == 'added' else '')) }}">
                                    <td t-esc="fila['product_name']"/>
                                    <td class="text-end" t-esc="fila['qty_original']"/>
                                    <td class="text-end" t-esc="fila['qty_actual']"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Decisión pendiente, por encima de la conversación (PRP v2 §8.3):
                     «Acepto» no confirma el pedido, la firma sigue siendo la nativa del
                     presupuesto -esto solo avisa al comercial de que puede prepararlo. -->
                <div class="d-flex gap-2 mb-3">
                    <form t-attf-action="/my/solicitud/#{order.id}/aceptar" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-success">
                            Acepto la propuesta
                        </button>
                    </form>
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-toggle="collapse" data-bs-target="#enteza_form_cambios">
                        Pedir cambios
                    </button>
                </div>
                <div class="collapse mb-3" id="enteza_form_cambios">
                    <form t-attf-action="/my/solicitud/#{order.id}/cambios" method="post" class="card card-body">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label class="form-label small">¿Qué te gustaría cambiar?</label>
                        <textarea name="body" class="form-control mb-2" rows="3" required="required"/>
                        <button type="submit" class="btn btn-primary align-self-start">Enviar</button>
                    </form>
                </div>

                <p class="text-muted">
                    También puedes revisar el presupuesto actualizado y, si estás de
                    acuerdo, aceptarlo y firmarlo directamente desde ahí.
                </p>
            </t>

            <t t-if="order.enteza_portal_state == 'composing'">
                <a t-attf-href="/my/solicitud/#{order.id}" class="btn btn-primary mb-3">
                    Seguir editando
                </a>
            </t>

            <!-- Conversación con el comercial (PRP v2 §8.3). Los 3 últimos mensajes
                 visibles, el resto plegado -progressive disclosure: no hace falta ver todo
                 el histórico para escribir un mensaje nuevo. -->
            <t t-if="order.enteza_portal_state != 'none'">
                <h5 class="mt-4">Conversación</h5>
                <t t-if="not mensajes">
                    <p class="text-muted small">Todavía no hay mensajes.</p>
                </t>
                <t t-else="">
                    <div class="enteza_mensajes">
                        <t t-foreach="mensajes[:3]" t-as="mensaje" t-key="mensaje['id']">
                            <div class="border rounded p-2 mb-2">
                                <div class="d-flex justify-content-between small text-muted">
                                    <strong t-esc="mensaje['author']"/>
                                    <span t-esc="mensaje['date']"/>
                                </div>
                                <div t-raw="mensaje['body']"/>
                            </div>
                        </t>
                    </div>
                    <t t-if="len(mensajes) > 3">
                        <a href="#" class="small" data-bs-toggle="collapse"
                           data-bs-target="#enteza_mensajes_resto">
                            Ver los <t t-esc="len(mensajes) - 3"/> anteriores
                        </a>
                        <div class="collapse mt-2" id="enteza_mensajes_resto">
                            <t t-foreach="mensajes[3:]" t-as="mensaje" t-key="mensaje['id']">
                                <div class="border rounded p-2 mb-2">
                                    <div class="d-flex justify-content-between small text-muted">
                                        <strong t-esc="mensaje['author']"/>
                                        <span t-esc="mensaje['date']"/>
                                    </div>
                                    <div t-raw="mensaje['body']"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>

                <a href="#" class="small d-block mt-2" data-bs-toggle="collapse"
                   data-bs-target="#enteza_form_mensaje">
                    Escribir al comercial
                </a>
                <div class="collapse mt-2" id="enteza_form_mensaje">
                    <form t-attf-action="/my/solicitud/#{order.id}/mensaje" method="post" class="card card-body">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <textarea name="body" class="form-control mb-2" rows="3" required="required"/>
                        <button type="submit" class="btn btn-primary align-self-start">Enviar</button>
                    </form>
                </div>
            </t>
        </t>
    </template>

</odoo>
