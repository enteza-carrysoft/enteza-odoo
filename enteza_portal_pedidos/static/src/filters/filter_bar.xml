<templates xml:space="preserve">
    <t t-name="enteza_portal_pedidos.FilterBar">
        <div class="enteza_filter_bar">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <div class="enteza_search flex-grow-1">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="Buscar por nombre o referencia..."
                           t-att-value="state.textoLocal"
                           t-on-input="onInputTexto"/>
                </div>
                <FacetDropdown label="'Categoría'"
                               options="props.categories"
                               selectedIds="props.filters.categoryIds"
                               multi="true"
                               getCount="(id) => this.getCategoryCount(id)"
                               onChange="(ids) => props.onCategoryChange(ids)"/>
                <t t-foreach="props.facets" t-as="faceta" t-key="faceta.id">
                    <FacetDropdown label="faceta.name"
                                   options="faceta.tags"
                                   selectedIds="facetSeleccion(faceta.id)"
                                   multi="faceta.multi"
                                   getCount="(id) => this.getFacetCount(faceta.id, id)"
                                   onChange="(ids) => props.onFacetChange(faceta.id, ids)"/>
                </t>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="enteza_f_habitual"
                           t-att-checked="props.filters.onlyHabitual"
                           t-on-change="(ev) => this.onToggle('onlyHabitual', ev)"/>
                    <label class="form-check-label" for="enteza_f_habitual">
                        Mis habituales
                    </label>
                </div>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="enteza_f_conqty"
                           t-att-checked="props.filters.onlyWithQty"
                           t-on-change="(ev) => this.onToggle('onlyWithQty', ev)"/>
                    <label class="form-check-label" for="enteza_f_conqty">
                        Solo con cantidad
                    </label>
                </div>
                <t t-if="props.semaforoActivo">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="enteza_f_disp"
                               t-att-checked="props.filters.hideUnavailable"
                               t-on-change="(ev) => this.onToggle('hideUnavailable', ev)"/>
                        <label class="form-check-label" for="enteza_f_disp">
                            Ocultar sin disponibilidad
                        </label>
                    </div>
                </t>
            </div>

            <ActiveChips chips="chips" onRemove="(id) => this.onRemoveChip(id)"
                         onClearAll="props.onClearAll"/>
        </div>
    </t>
</templates>
