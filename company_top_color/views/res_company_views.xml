<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_top_color" model="ir.ui.view">
        <field name="name">res.company.form.top.color</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="top_bar_color"
                       widget="color_picker"
                       string="Identification color"
                       help="Shows a thin colored strip at the top of Odoo for this company. It does not alter Light/Dark mode."/>
            </xpath>
        </field>
    </record>
</odoo>
