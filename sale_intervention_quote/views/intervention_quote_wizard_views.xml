<odoo>
  <!-- Vista para las líneas de material -->
  <record id="view_intervention_material_line_tree" model="ir.ui.view">
    <field name="name">intervention.material.line.tree</field>
    <field name="model">intervention.material.line</field>
    <field name="arch" type="xml">
      <tree editable="bottom">
        <field name="product_id"/>
        <field name="quantity"/>
      </tree>
    </field>
  </record>

  <!-- Vista principal del wizard -->
  <record id="view_intervention_quote_wizard_form" model="ir.ui.view">
    <field name="name">intervention.quote.wizard.form</field>
    <field name="model">intervention.quote.wizard</field>
    <field name="arch" type="xml">
      <form string="Generar presupuesto de intervención">
        <group>
          <group>
            <field name="order_id" invisible="1"/>
            <field name="distance_km_one_way"/>
            <field name="on_site_hours"/>
            <field name="num_workers"/>
            <field name="overtime_hours_per_worker"/>
          </group>
          <group string="Ajustes de cálculo">
            <field name="speed_kmh"/>
            <field name="product_labor_normal_id" options="{'no_create_edit': True}"/>
            <field name="product_labor_overtime_id" options="{'no_create_edit': True}"/>
            <field name="product_mobile_unit_id" options="{'no_create_edit': True}"/>
            <field name="mobile_time_uom"/>
            <field name="consumables_percent"/>
            <field name="product_consumables_id" options="{'no_create_edit': True}"/>
          </group>
        </group>
        <group string="Materiales">
            <field name="material_line_ids" context="{'default_wizard_id': active_id}"/>
        </group>
        <footer>
          <button string="Generar líneas" type="object" name="action_apply" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
