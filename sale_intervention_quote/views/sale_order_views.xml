<odoo>
  <record id="view_order_form_intervention_button" model="ir.ui.view">
    <field name="name">sale.order.form.intervention.button</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_intervention_wizard"
                type="object"
                string="Presupuesto de intervención"
                class="btn-secondary"
                attrs="{'invisible': [('state','not in',('draft','sent'))]}"/>
      </xpath>
    </field>
  </record>
</odoo>
