<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_venta_intercompania" model="ir.ui.view">
        <field name="name">res.company.form.enteza.venta.intercompania</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Material perdido de otra compañía" name="enteza_venta_intercompania">
                    <field name="enteza_ic_owner_company_id" options="{'no_create': True}"/>
                    <field name="enteza_ic_journal_id"
                           invisible="not enteza_ic_owner_company_id"
                           required="enteza_ic_owner_company_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
