<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rental_order_rename_wizard_view_form" model="ir.ui.view">
        <field name="name">rental.order.rename.wizard.form</field>
        <field name="model">rental.order.rename.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar número de presupuesto">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="name"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
