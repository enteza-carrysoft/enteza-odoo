<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del formulario del asistente -->
    <record id="view_create_sale_from_picking_form" model="ir.ui.view">
        <field name="name">wizards.create.sale.form</field>
        <field name="model">wizards.create.sale</field>
        <field name="arch" type="xml">
            <form string="Crear Orden de Venta">
                <p>Se creará una orden de venta basada en el albarán actual.</p>
                <footer>
                    <button name="action_create_sale" string="Crear Orden de Venta" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el asistente -->
    <record id="action_create_sale_from_picking" model="ir.actions.act_window">
        <field name="name">Crear Orden de Venta</field>
        <field name="res_model">wizards.create.sale</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
