<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rental_missing_wizard_view_form" model="ir.ui.view">
        <field name="name">rental.missing.wizard.form</field>
        <field name="model">rental.missing.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar faltas">
                <div class="text-muted mb-2">
                    Escribe en «Faltas» las unidades que no han vuelto. Con todo a 0, el pedido
                    solo se marca como devuelto. Con faltas, se crea el pedido de faltas y, al
                    confirmarlo, esas unidades se dan de baja del almacén.
                </div>
                <div class="text-muted mb-2">
                    Escribe la referencia en el buscador y pulsa Intro para ir a sus faltas; Intro
                    otra vez vuelve al buscador. Las flechas ↑ ↓ recorren la columna «Faltas».
                </div>
                <field name="order_id" invisible="1"/>
                <field name="line_ids" widget="rental_missing_lines">
                    <list editable="bottom" create="false" delete="false" limit="1000">
                        <field name="sale_line_id" column_invisible="1"/>
                        <field name="default_code" readonly="1"/>
                        <field name="product_id" readonly="1"
                               context="{'display_default_code': False}"/>
                        <field name="qty_rented" readonly="1"/>
                        <field name="qty_lost_prev" readonly="1"/>
                        <field name="qty_missing"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Facturar las faltas"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
