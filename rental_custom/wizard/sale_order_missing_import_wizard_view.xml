<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_sale_order_import_wizard" model="ir.ui.view">
        <field name="name">rental.sale.order.import.wizard.form</field>
        <field name="model">rental.sale.order.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar ventas por faltas">
                <group>
                    <field name="company_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Selecciona un CSV UTF-8 o un libro Excel (.xlsx). Las columnas obligatorias son
                    <strong>CIF</strong>, <strong>Codigo articulo</strong> y <strong>Unidades</strong>.
                    Formatea CIF y código de artículo como texto para conservar los ceros iniciales.
                    Cada cambio de CIF respecto a la fila anterior crea un presupuesto nuevo.
                    Los pedidos se crean en borrador y, al confirmarlos, no generan albarán de salida.
                </div>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rental_sale_order_import" model="ir.actions.act_window">
        <field name="name">Importar ventas por faltas</field>
        <field name="res_model">rental.sale.order.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('rental_custom.group_faltas_alquiler'))]"/>
    </record>
</odoo>
