<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form - sale_line_returned_qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_primary_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_rental_order_rename_wizard"
                        type="object"
                        string="Cambiar número"
                        invisible="not is_rental_order or state not in ['draft', 'sent']"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <!-- Obligatoria: esta vista es la del formulario de ALQUILER
                     (`sale_renting.rental_order_primary_form_view`), así que no afecta a los
                     pedidos de venta normales. Sin ella, la factura sale sin fecha de evento y
                     el calendario de eventos no coloca el pedido. -->
                <field name="event_date" required="1" />
        	<field name="place_number" />
            </xpath>
            <xpath expr="//field[@name='rental_return_date']" position="after">
                <field name="rental_billable_days"
                       invisible="not is_rental_order"
                       readonly="state not in ['draft', 'sent']"/>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="warehouse_id" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-warning mb-0" role="alert" invisible="not compensation_order_ids">
                    Hay material de este alquiler no devuelto, facturado como venta en:
                    <field name="compensation_order_ids" widget="many2many_tags" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='qty_returned']" position="after">
                <field name="qty_lost"
                       string="No devueltas"
                       column_invisible="parent.state != 'sale' or not parent.is_rental_order"
                       invisible="not is_rental or not qty_lost"/>
            </xpath>
        </field>
    </record>

    <record id="rental_order_view_tree_invoice_status" model="ir.ui.view">
        <field name="name">rental.order.list.invoice.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="invoice_status" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

