<odoo>
    <record id="view_order_tree_invoiced_amount" model="ir.ui.view">
        <field name="name">sale.order.tree.invoiced_amount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_status']"
                position="after"
            >
                <field name="concurrent_orders"
                       decoration-success="concurrent_orders == 'none'"
                       decoration-warning="concurrent_orders == 'any'"
                       widget="badge"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form - sale_line_returned_qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="event_date" />
        		<field name="place_number" />
		        <field name="not_reserved" />
            </xpath>
            <xpath expr="//tree" position="attributes">
		    <attribute name="limit">200</attribute>
		    <attribute name="default_order">product_categ_id asc,name asc</attribute>
	    </xpath>
	    <xpath expr="//tree//field[@name='display_product_id']" position="before">
		    <field name="product_categ_id"/>
	    </xpath>
        </field>
    </record>


    <record id="view_stock_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form - limit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
		    <attribute name="limit">200</attribute>
		    <attribute name="default_order">product_categ_id asc,product_id asc</attribute>
	    </xpath>
	    <xpath expr="//field[@name='product_qty']" position="after">
		    <field name="product_categ_id" />
		    <field name="missing_units" string="Faltan Uds." readonly="1"/>
	    </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_form1" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.form1</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_code']" position="after">
		    <field name="missing_units" string="Faltan Uds."/>
	    </xpath>
        </field>
    </record>
</odoo>

