<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_rental_missing_journal" model="ir.ui.view">
        <field name="name">res.company.form.rental.missing.journal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Faltas de alquiler" name="rental_custom_faltas">
                    <field name="rental_missing_journal_id" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
