<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_enteza" model="ir.ui.view">
        <field name="name">sale_rental.view_order_form_enteza</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_start_end_dates.view_order_form"/>
        <field name="arch" type="xml">

            <xpath
                expr="//field[@name='order_line']/tree//button[@name='action_view_concurrent_orders']"
                position="after"
            >
                <button
                    name="open_my_wizard"
                    type="object"
                    icon="fa-list-alt"
                    class="oe_inline"
                    style="color: #ff0000; font-size: 2rem"
                    string=""
                    attrs="{'invisible': [
                                   '|',
                                   ('concurrent_orders','=', 'none'),
                                   ('concurrent_orders','=', False),
                               ]}"
                />
<!--                <button-->
<!--                    name="action_view_concurrent_orders_line"-->
<!--                    type="object"-->
<!--                    icon="fa-list-alt"-->
<!--                    class="oe_inline"-->
<!--                    style="color: #ff0000; font-size: 2rem"-->
<!--                    string=""-->
<!--                    attrs="{'invisible': [-->
<!--                                   '|',-->
<!--                                   ('concurrent_orders','=', 'none'),-->
<!--                                   ('concurrent_orders','=', False),-->
<!--                               ]}"-->
<!--                />-->
            </xpath>

            <xpath
                expr="//field[@name='order_line']/tree//button[@name='action_view_concurrent_orders']"
                position="replace"
            >
            </xpath>


        </field>
    </record>

    <record id="view_order_line_current_tree" model="ir.ui.view">
        <field name="name">sale.order.line.tree</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <tree string="Sales Order Lines" create="false">
                <field name="order_id"/>
                <field name="order_partner_id"/>
                <field name="name"/>
<!--                <field name="default_start_date"/>-->
<!--                <field name="default_end_date"/>-->
                <field name="salesman_id"/>
                <field name="product_uom_qty" string="Quantity" sum="Total"/>
                <field name="stock_available" string="Stock"/>
                <field name="invoice_status" decoration-success="invoice_status == 'invoiced'"
                       decoration-info="invoice_status == 'to invoice'"
                       decoration-warning="invoice_status == 'upselling'" widget="badge" optional="show"/>
                <field name="price_subtotal" sum="Total" widget="monetary"/>
            </tree>
        </field>
    </record>

    <record id="action_rental_orders_lines" model="ir.actions.act_window">
        <field name="name">Rental Orders Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_order_line_current_tree"/>
    </record>


</odoo>
