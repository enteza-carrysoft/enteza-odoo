<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Record Rules for rental.change_request -->
        <record id="rental_change_request_rule_portal" model="ir.rule">
            <field name="name">Portal: Own Change Requests</field>
            <field name="model_id" ref="model_rental_change_request"/>
            <field name="domain_force">[('order_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rental_change_request_rule_manager" model="ir.rule">
            <field name="name">Manager: All Change Requests</field>
            <field name="model_id" ref="model_rental_change_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rules for rental.change_request.line -->
        <record id="rental_change_request_line_rule_portal" model="ir.rule">
            <field name="name">Portal: Own Change Request Lines</field>
            <field name="model_id" ref="model_rental_change_request_line"/>
            <field name="domain_force">[('change_request_id.order_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rental_change_request_line_rule_manager" model="ir.rule">
            <field name="name">Manager: All Change Request Lines</field>
            <field name="model_id" ref="model_rental_change_request_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
