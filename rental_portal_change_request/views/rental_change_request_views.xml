<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Rental Change Request Tree View -->
        <record id="rental_change_request_tree_view" model="ir.ui.view">
            <field name="name">rental.change_request.tree</field>
            <field name="model">rental.change_request</field>
            <field name="priority">16</field>
            <field name="arch" type="xml">
                <list string="Change Requests"
                      decoration-muted="state == 'cancelled'"
                      decoration-success="state == 'approved'"
                      decoration-warning="state == 'submitted'">
                    <field name="name"/>
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'submitted'"
                           decoration-success="state == 'approved'"
                           decoration-danger="state == 'rejected'"
                           decoration-muted="state == 'cancelled'"/>
                    <field name="submitted_date"/>
                    <field name="line_count"/>
                </list>
            </field>
        </record>

        <!-- Rental Change Request Form View -->
        <record id="rental_change_request_form_view" model="ir.ui.view">
            <field name="name">rental.change_request.form</field>
            <field name="model">rental.change_request</field>
            <field name="priority">16</field>
            <field name="arch" type="xml">
                <form string="Change Request">
                    <header>
                        <!-- Approve ALL lines and apply everything -->
                        <button name="action_approve" string="Approve All &amp; Apply" type="object"
                                class="btn-primary"
                                invisible="state != 'submitted'"
                                groups="sales_team.group_sale_manager"/>
                        <!-- Apply only lines already marked as Approved, reject the rest -->
                        <button name="action_apply_partial" string="Apply Approved Lines" type="object"
                                class="btn-success"
                                invisible="state != 'submitted' or approved_lines_count == 0"
                                groups="sales_team.group_sale_manager"/>
                        <!-- Reject everything -->
                        <button name="action_reject" string="Reject All" type="object"
                                invisible="state != 'submitted'"
                                groups="sales_team.group_sale_manager"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state in ('approved', 'cancelled')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="order_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="submitted_date"/>
                                <field name="submitted_by"/>
                                <field name="approved_date" invisible="state not in ('approved',)"/>
                                <field name="approved_by" invisible="state not in ('approved',)"/>
                            </group>
                        </group>

                        <!-- Decision summary (visible when submitted) -->
                        <div class="alert alert-info d-flex gap-4 mb-0"
                             invisible="state != 'submitted'">
                            <span>
                                <i class="fa fa-clock-o me-1"/>
                                <strong><field name="pending_lines_count" readonly="1"/></strong> pending
                            </span>
                            <span>
                                <i class="fa fa-check-circle text-success me-1"/>
                                <strong><field name="approved_lines_count" readonly="1"/></strong> approved
                            </span>
                            <span>
                                <i class="fa fa-times-circle text-danger me-1"/>
                                <strong><field name="rejected_lines_count" readonly="1"/></strong> rejected
                            </span>
                        </div>

                        <notebook>
                            <page string="Lines" name="changes">
                                <field name="change_request_line_ids">
                                    <list decoration-success="approval_state == 'approved'"
                                          decoration-danger="approval_state == 'rejected'"
                                          decoration-muted="approval_state == 'rejected'">
                                        <field name="product_id" readonly="1"/>
                                        <field name="operation" widget="badge"
                                               decoration-success="operation == 'add'"
                                               decoration-danger="operation == 'remove'"
                                               decoration-warning="operation == 'update'"
                                               readonly="1"/>
                                        <field name="original_qty" string="Original" readonly="1"/>
                                        <field name="new_qty" string="Requested" readonly="1"/>
                                        <field name="approval_state" widget="badge"
                                               decoration-warning="approval_state == 'pending'"
                                               decoration-success="approval_state == 'approved'"
                                               decoration-danger="approval_state == 'rejected'"
                                               readonly="1"/>
                                        <field name="staff_note" string="Note" optional="show"
                                               readonly="parent.state != 'submitted'"/>
                                        <!-- Per-line approve/reject buttons (only visible when pending + CR is submitted) -->
                                        <button name="action_approve_line" type="object"
                                                string="Approve" icon="fa-check"
                                                class="btn-success btn-sm"
                                                invisible="approval_state != 'pending' or parent.state != 'submitted'"/>
                                        <button name="action_reject_line" type="object"
                                                string="Reject" icon="fa-times"
                                                class="btn-danger btn-sm"
                                                invisible="approval_state != 'pending' or parent.state != 'submitted'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <group>
                                    <field name="submission_note" string="Customer Message" readonly="1"/>
                                    <field name="internal_note"/>
                                    <field name="rejection_reason" readonly="1"
                                           invisible="state != 'rejected'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Rental Change Request Search View -->
        <record id="rental_change_request_search_view" model="ir.ui.view">
            <field name="name">rental.change_request.search</field>
            <field name="model">rental.change_request</field>
            <field name="priority">16</field>
            <field name="arch" type="xml">
                <search string="Search Change Requests">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <!-- Rental Change Request Action -->
        <record id="rental_change_request_action" model="ir.actions.act_window">
            <field name="name">Change Requests</field>
            <field name="res_model">rental.change_request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No change requests yet
                </p>
                <p>
                    Customers can submit change requests from the portal.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="rental_change_request_menu"
                  name="Change Requests"
                  parent="sale.sale_order_menu"
                  action="rental_change_request_action"
                  sequence="5"/>

        <!-- Reject Wizard View -->
        <record id="rental_change_request_reject_wizard_view" model="ir.ui.view">
            <field name="name">rental.change_request.reject.wizard.form</field>
            <field name="model">rental.change_request.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Change Request">
                    <sheet>
                        <group>
                            <field name="change_request_id" readonly="1"/>
                            <field name="reason" required="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_reject" string="Reject" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
