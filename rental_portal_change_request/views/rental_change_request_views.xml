<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Rental Change Request Tree View -->
        <record id="rental_change_request_tree_view" model="ir.ui.view">
            <field name="name">rental.change_request.tree</field>
            <field name="model">rental.change_request</field>
            <field name="arch" type="xml">
                <list string="Change Requests"
                      decoration-muted="state == 'cancelled'"
                      decoration-success="state == 'approved'"
                      decoration-warning="state == 'submitted'">
                    <field name="name"/>
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'submitted'"
                           decoration-success="state == 'approved'"
                           decoration-danger="state == 'rejected'"
                           decoration-muted="state == 'cancelled'"/>
                    <field name="submitted_date"/>
                    <field name="line_count"/>
                </list>
            </field>
        </record>

        <!-- Rental Change Request Form View -->
        <record id="rental_change_request_form_view" model="ir.ui.view">
            <field name="name">rental.change_request.form</field>
            <field name="model">rental.change_request</field>
            <field name="arch" type="xml">
                <form string="Change Request">
                    <header>
                        <button name="action_approve" string="Approve" type="object"
                                class="btn-primary"
                                invisible="state != 'submitted'"
                                groups="sales_team.group_sale_manager"/>
                        <button name="action_reject" string="Reject" type="object"
                                invisible="state != 'submitted'"
                                groups="sales_team.group_sale_manager"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state in ('approved', 'cancelled')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="order_id"/>
                                <field name="partner_id"/>
                                <field name="line_count"/>
                            </group>
                            <group>
                                <field name="submitted_date"/>
                                <field name="submitted_by"/>
                                <field name="approved_date" invisible="state not in ('approved',)"/>
                                <field name="approved_by" invisible="state not in ('approved',)"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Requested Changes" name="changes">
                                <field name="change_request_line_ids" readonly="1">
                                    <list decoration-success="operation == 'add'"
                                          decoration-danger="operation == 'remove'"
                                          decoration-warning="operation == 'update'">
                                        <field name="product_id"/>
                                        <field name="operation" widget="badge"/>
                                        <field name="original_qty"/>
                                        <field name="new_qty"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <group>
                                    <field name="submission_note" string="Customer Message" readonly="1"/>
                                    <field name="internal_note"/>
                                    <field name="rejection_reason" readonly="1"
                                           invisible="state != 'rejected'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Rental Change Request Search View -->
        <record id="rental_change_request_search_view" model="ir.ui.view">
            <field name="name">rental.change_request.search</field>
            <field name="model">rental.change_request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <filter string="Pending" name="pending" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                    <group expand="0" string="Group By">
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Rental Change Request Action -->
        <record id="rental_change_request_action" model="ir.actions.act_window">
            <field name="name">Change Requests</field>
            <field name="res_model">rental.change_request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No change requests yet
                </p>
                <p>
                    Customers can submit change requests from the portal.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="rental_change_request_menu"
                  name="Change Requests"
                  parent="sale.sale_order_menu"
                  action="rental_change_request_action"
                  sequence="5"/>

        <!-- Reject Wizard View -->
        <record id="rental_change_request_reject_wizard_view" model="ir.ui.view">
            <field name="name">rental.change_request.reject.wizard.form</field>
            <field name="model">rental.change_request.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Change Request">
                    <sheet>
                        <group>
                            <field name="change_request_id" readonly="1"/>
                            <field name="reason" required="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_reject" string="Reject" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
