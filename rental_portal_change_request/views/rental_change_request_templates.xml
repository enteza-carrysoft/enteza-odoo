<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal: List of Rental Orders -->
        <template id="portal_my_rentals_page" name="My Rental Orders">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Rental Orders</t>
                </t>

                <t t-if="not orders">
                    <div class="alert alert-info">
                        You don't have any rental orders yet.
                    </div>
                </t>

                <t t-if="orders">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Date</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="orders" t-as="order">
                                    <td>
                                        <strong t-out="order.name"/>
                                        <t t-if="order.x_active_change_request_id and order.x_active_change_request_id.state == 'submitted'">
                                            <span class="badge bg-warning text-dark ms-2">Change Pending</span>
                                        </t>
                                    </td>
                                    <td t-out="order.date_order" t-options="{'widget': 'date'}"/>
                                    <td class="text-center">
                                        <span t-if="order.state == 'sale'" class="badge bg-success">Confirmed</span>
                                        <span t-elif="order.state == 'done'" class="badge bg-info">Done</span>
                                        <span t-elif="order.state == 'cancel'" class="badge bg-secondary">Cancelled</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <a t-attf-href="/my/rentals/#{order.id}" class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <!-- Portal: Rental Order Details -->
        <template id="portal_rental_order_page" name="Rental Order Details">
            <t t-call="portal.portal_layout">
                <t t-set="o_portal_fullwidth_alert" groups="sales_team.group_sale_salesman">
                    <t t-call="portal.portal_back_in_edit_mode">
                        <t t-set="backend_url" t-value="'/web#model=sale.order&amp;id=%d&amp;view_type=form' % order.id"/>
                    </t>
                </t>

                <div class="container py-4">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2>
                            <i class="fa fa-file-text-o me-2"/>
                            <t t-out="order.name"/>
                        </h2>
                        <a href="/my/rentals" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"/> Back to Orders
                        </a>
                    </div>

                    <!-- Pending Change Request Alert -->
                    <t t-if="active_change_request and active_change_request.state == 'submitted'">
                        <div class="alert alert-warning">
                            <i class="fa fa-clock-o me-2"/>
                            <strong>Change Request Pending:</strong>
                            Your change request <t t-out="active_change_request.name"/> is pending approval.
                        </div>
                    </t>

                    <div class="row">
                        <!-- Order Info -->
                        <div class="col-lg-4 mb-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">Order Information</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-5">Order Date:</dt>
                                        <dd class="col-7" t-out="order.date_order" t-options="{'widget': 'date'}"/>

                                        <dt class="col-5">Status:</dt>
                                        <dd class="col-7">
                                            <span t-if="order.state == 'sale'" class="badge bg-success">Confirmed</span>
                                            <span t-elif="order.state == 'done'" class="badge bg-info">Done</span>
                                            <span t-elif="order.state == 'cancel'" class="badge bg-secondary">Cancelled</span>
                                        </dd>

                                        <dt class="col-5">Total:</dt>
                                        <dd class="col-7">
                                            <strong t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- Request Changes Button -->
                            <t t-if="order.state == 'sale' and (not active_change_request or active_change_request.state not in ['draft', 'submitted'])">
                                <div class="mt-3">
                                    <a t-attf-href="/my/rentals/#{order.id}/change-request" class="btn btn-primary w-100">
                                        <i class="fa fa-edit me-1"/> Request Changes
                                    </a>
                                </div>
                            </t>
                        </div>

                        <!-- Order Lines grouped by family -->
                        <div class="col-lg-8">

                            <!-- Header + Expand/Collapse All -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="mb-0">Order Lines</h5>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-expand-all">
                                        <i class="fa fa-plus-square-o me-1"/>Expand all
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-collapse-all">
                                        <i class="fa fa-minus-square-o me-1"/>Collapse all
                                    </button>
                                </div>
                            </div>

                            <!-- Accordion: one item per family -->
                            <div class="accordion border rounded" id="orderLinesAccordion">

                                <t t-foreach="grouped_lines" t-as="group">
                                    <t t-set="categ_name" t-value="group[0]"/>
                                    <t t-set="categ_lines" t-value="group[1]"/>

                                    <div class="accordion-item">
                                        <h2 class="accordion-header" t-attf-id="heading-#{group_index}">
                                            <button class="accordion-button py-2 collapsed" type="button"
                                                    data-bs-toggle="collapse"
                                                    t-attf-data-bs-target="#collapse-#{group_index}"
                                                    aria-expanded="false"
                                                    t-attf-aria-controls="collapse-#{group_index}">
                                                <i class="fa fa-tag me-2 text-muted" style="font-size:0.8rem;"/>
                                                <span class="fw-semibold me-2"><t t-out="categ_name"/></span>
                                                <span class="badge bg-secondary rounded-pill fw-normal" t-out="len(categ_lines)"/>
                                            </button>
                                        </h2>
                                        <div t-attf-id="collapse-#{group_index}"
                                             class="accordion-collapse collapse"
                                             t-attf-aria-labelledby="heading-#{group_index}">
                                            <div class="accordion-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Product</th>
                                                                <th class="text-center" style="width:80px;">Qty</th>
                                                                <th class="text-end" style="width:90px;">Price</th>
                                                                <th class="text-end" style="width:100px;">Subtotal</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <t t-foreach="categ_lines" t-as="line">
                                                                <t t-set="pending" t-value="pending_changes.get(line.product_id.id) if pending_changes else False"/>
                                                                <tr>
                                                                    <td>
                                                                        <span t-out="line.product_id.display_name"/>
                                                                        <t t-if="pending and pending.get('operation') == 'remove'">
                                                                            <span class="badge bg-danger ms-1">Pending removal</span>
                                                                        </t>
                                                                    </td>
                                                                    <td class="text-center">
                                                                        <t t-if="pending and pending.get('operation') == 'update'">
                                                                            <span class="text-decoration-line-through text-muted me-1"><t t-out="line.product_uom_qty"/></span>
                                                                            <i class="fa fa-arrow-right mx-1 text-primary"/>
                                                                            <span class="text-primary fw-bold"><t t-out="pending.get('new_qty')"/></span>
                                                                            <span class="badge bg-warning text-dark ms-1">Pending</span>
                                                                        </t>
                                                                        <t t-elif="pending and pending.get('operation') == 'remove'">
                                                                            <span class="text-decoration-line-through text-muted"><t t-out="line.product_uom_qty"/></span>
                                                                        </t>
                                                                        <t t-else="">
                                                                            <t t-out="line.product_uom_qty"/>
                                                                        </t>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <span t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <span t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>

                                <!-- Pending Additions (separate section, always visible) -->
                                <t t-if="pending_additions">
                                    <div class="accordion-item border-success">
                                        <h2 class="accordion-header" id="headingAdditions">
                                            <button class="accordion-button py-2" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapseAdditions"
                                                    aria-expanded="true"
                                                    aria-controls="collapseAdditions"
                                                    style="background-color:rgba(25,135,84,.08); color:#146c43;">
                                                <i class="fa fa-plus-circle me-2"/>
                                                <span class="fw-semibold me-2">Pending Additions</span>
                                                <span class="badge bg-success rounded-pill fw-normal" t-out="len(pending_additions)"/>
                                            </button>
                                        </h2>
                                        <div id="collapseAdditions"
                                             class="accordion-collapse collapse show"
                                             aria-labelledby="headingAdditions">
                                            <div class="accordion-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-sm mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Product</th>
                                                                <th class="text-center" style="width:80px;">Qty</th>
                                                                <th class="text-end" style="width:90px;">Price</th>
                                                                <th class="text-end" style="width:100px;">Subtotal</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <t t-foreach="pending_additions" t-as="add_line">
                                                                <tr class="table-success">
                                                                    <td>
                                                                        <span t-out="add_line.product_id.display_name"/>
                                                                        <span class="badge bg-success ms-1">New · Pending</span>
                                                                    </td>
                                                                    <td class="text-center text-success fw-bold">
                                                                        <t t-out="add_line.new_qty"/>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <span t-out="add_line.new_price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                                    </td>
                                                                    <td class="text-end text-muted">—</td>
                                                                </tr>
                                                            </t>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>

                            </div><!-- /accordion -->

                            <!-- Total -->
                            <div class="d-flex justify-content-end mt-3">
                                <table class="table table-sm w-auto mb-0">
                                    <tr>
                                        <td class="text-end border-0 pe-3"><strong>Total:</strong></td>
                                        <td class="text-end border-0">
                                            <strong t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- JS for expand/collapse all -->
                            <script type="text/javascript" src="/rental_portal_change_request/static/src/js/rental_portal_order.js"/>

                        </div>
                    </div>
                <!-- ── Change Request History ──────────────────────────────── -->
                <t t-if="cr_history">
                    <div class="mt-5">
                        <div class="d-flex align-items-center mb-3">
                            <h5 class="mb-0">
                                <i class="fa fa-history me-2 text-muted"/>
                                Change Request History
                            </h5>
                            <span class="badge bg-secondary ms-2" t-out="len(cr_history)"/>
                        </div>

                        <div class="accordion" id="crHistoryAccordion">
                            <t t-foreach="cr_history" t-as="cr">
                                <div class="accordion-item">

                                    <!-- Header -->
                                    <h2 class="accordion-header" t-attf-id="crh-heading-#{cr_index}">
                                        <button class="accordion-button collapsed py-2" type="button"
                                                data-bs-toggle="collapse"
                                                t-attf-data-bs-target="#crh-collapse-#{cr_index}"
                                                aria-expanded="false"
                                                t-attf-aria-controls="crh-collapse-#{cr_index}">
                                            <span class="fw-semibold me-3" t-out="cr.name"/>
                                            <span class="text-muted small me-3">
                                                <t t-out="cr.submitted_date" t-options="{'widget': 'date'}"/>
                                            </span>
                                            <!-- State badge -->
                                            <span t-if="cr.state == 'submitted'"
                                                  class="badge bg-warning text-dark me-2">
                                                <i class="fa fa-clock-o me-1"/>Awaiting review
                                            </span>
                                            <span t-elif="cr.state == 'approved'"
                                                  class="badge bg-success me-2">
                                                <i class="fa fa-check me-1"/>Applied
                                            </span>
                                            <span t-elif="cr.state == 'rejected'"
                                                  class="badge bg-danger me-2">
                                                <i class="fa fa-times me-1"/>Rejected
                                            </span>
                                            <span t-elif="cr.state == 'cancelled'"
                                                  class="badge bg-secondary me-2">Cancelled</span>
                                            <!-- Line counts -->
                                            <span class="badge bg-light text-dark border small">
                                                <t t-out="cr.line_count"/> lines
                                            </span>
                                        </button>
                                    </h2>

                                    <!-- Body -->
                                    <div t-attf-id="crh-collapse-#{cr_index}"
                                         class="accordion-collapse collapse"
                                         t-attf-aria-labelledby="crh-heading-#{cr_index}">
                                        <div class="accordion-body pt-3">

                                            <!-- Customer note -->
                                            <t t-if="cr.submission_note">
                                                <div class="alert alert-light border mb-3">
                                                    <strong>
                                                        <i class="fa fa-comment me-1"/>Your message:
                                                    </strong>
                                                    <p class="mb-0 mt-1" t-out="cr.submission_note"/>
                                                </div>
                                            </t>

                                            <!-- Global rejection reason -->
                                            <t t-if="cr.rejection_reason">
                                                <div class="alert alert-danger mb-3">
                                                    <strong>
                                                        <i class="fa fa-times-circle me-1"/>Rejection reason:
                                                    </strong>
                                                    <p class="mb-0 mt-1" t-out="cr.rejection_reason"/>
                                                </div>
                                            </t>

                                            <!-- Lines detail table -->
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Product</th>
                                                            <th class="text-center" style="width:80px;">Change</th>
                                                            <th class="text-center" style="width:80px;">Original</th>
                                                            <th class="text-center" style="width:80px;">Requested</th>
                                                            <th class="text-center" style="width:90px;">Decision</th>
                                                            <th>Note</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="cr.change_request_line_ids" t-as="cr_line">
                                                            <tr t-att-class="{
                                                                'table-success': cr_line.approval_state == 'approved',
                                                                'table-danger': cr_line.approval_state == 'rejected'
                                                            }">
                                                                <td>
                                                                    <span t-out="cr_line.product_id.display_name"/>
                                                                </td>
                                                                <td class="text-center">
                                                                    <span t-if="cr_line.operation == 'add'"
                                                                          class="badge bg-success">Add</span>
                                                                    <span t-elif="cr_line.operation == 'remove'"
                                                                          class="badge bg-danger">Remove</span>
                                                                    <span t-elif="cr_line.operation == 'update'"
                                                                          class="badge bg-warning text-dark">Update</span>
                                                                </td>
                                                                <td class="text-center text-muted">
                                                                    <t t-if="cr_line.original_qty"
                                                                       t-out="cr_line.original_qty"/>
                                                                    <t t-else="">&#8212;</t>
                                                                </td>
                                                                <td class="text-center">
                                                                    <t t-if="cr_line.new_qty"
                                                                       t-out="cr_line.new_qty"/>
                                                                    <t t-else="">&#8212;</t>
                                                                </td>
                                                                <td class="text-center">
                                                                    <span t-if="cr_line.approval_state == 'approved'"
                                                                          class="badge bg-success">
                                                                        <i class="fa fa-check me-1"/>Approved
                                                                    </span>
                                                                    <span t-elif="cr_line.approval_state == 'rejected'"
                                                                          class="badge bg-danger">
                                                                        <i class="fa fa-times me-1"/>Rejected
                                                                    </span>
                                                                    <span t-else=""
                                                                          class="badge bg-warning text-dark">
                                                                        <i class="fa fa-clock-o me-1"/>Pending
                                                                    </span>
                                                                </td>
                                                                <td class="small text-muted">
                                                                    <t t-if="cr_line.staff_note"
                                                                       t-out="cr_line.staff_note"/>
                                                                    <t t-else="">&#8212;</t>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </div><!-- /table-responsive -->

                                            <!-- Approval summary footer -->
                                            <t t-if="cr.state == 'approved'">
                                                <div class="d-flex gap-3 mt-3 small text-muted">
                                                    <span>
                                                        <i class="fa fa-check-circle text-success me-1"/>
                                                        <strong t-out="cr.approved_lines_count"/> applied
                                                    </span>
                                                    <t t-if="cr.rejected_lines_count">
                                                        <span>
                                                            <i class="fa fa-times-circle text-danger me-1"/>
                                                            <strong t-out="cr.rejected_lines_count"/> rejected
                                                        </span>
                                                    </t>
                                                    <span class="ms-auto">
                                                        Reviewed by
                                                        <strong t-out="cr.approved_by.name"/>
                                                        on <t t-out="cr.approved_date" t-options="{'widget': 'date'}"/>
                                                    </span>
                                                </div>
                                            </t>

                                        </div><!-- /accordion-body -->
                                    </div><!-- /accordion-collapse -->
                                </div><!-- /accordion-item -->
                            </t>
                        </div><!-- /accordion -->
                    </div>
                </t>
                <!-- ── /Change Request History ─────────────────────────────── -->

                </div>
            </t>
        </template>

        <!-- Portal: Change Request Editor -->
        <template id="portal_change_request_editor" name="Change Request Editor">
            <t t-call="portal.portal_layout">
                <div id="rental-change-request-app" t-att-data-order-id="order.id">
                    <!-- Editor will mount here -->
                    <div class="text-center py-5">
                        <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                        <p class="mt-3">Loading editor...</p>
                    </div>
                </div>

                <!-- Load editor script -->
                <script type="text/javascript" src="/rental_portal_change_request/static/src/js/rental_portal_editor.js"/>
            </t>
        </template>

    </data>
</odoo>
