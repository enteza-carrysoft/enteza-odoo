<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal: add "My Rentals" entry to portal home -->
    <template id="portal_my_rentals" name="My Rental Orders" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="rental_count" t-call="portal.portal_docs_entry">
                <t t-set="title">Rental Orders</t>
                <t t-set="url">/my/rentals</t>
                <t t-set="count" t-value="rental_count"/>
            </t>
        </xpath>
    </template>

    <!-- My Rentals list page -->
    <template id="portal_my_rentals_page" name="My Rental Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar">True</t>

            <div class="o_portal_sale_details container mt-3 mb-5">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="mb-0">My Rental Orders</h4>
                            </div>
                            <div class="card-body">
                                <t t-if="not orders">
                                    <p class="text-center text-muted">You have no rental orders yet.</p>
                                </t>
                                <t t-if="orders">
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr>
                                                <th>Order Number</th>
                                                <th>Date</th>
                                                <th>Pickup Date</th>
                                                <th>State</th>
                                                <th class="text-end">Total</th>
                                                <th class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="orders" t-as="order">
                                                <td>
                                                    <a t-attf-href="/my/rentals/#{order.id}">
                                                        <t t-out="order.name"/>
                                                    </a>
                                                </td>
                                                <td><t t-out="order.date_order"/></td>
                                                <td><t t-out="order.x_rental_pickup_date or '-'"/></td>
                                                <td>
                                                    <!-- Bootstrap 5: badge uses bg-* classes -->
                                                    <span class="badge bg-info text-white">
                                                        <t t-out="order.state"/>
                                                    </span>
                                                    <t t-if="order.x_active_change_request_id">
                                                        <span class="badge bg-warning text-dark ms-1">Changes Pending</span>
                                                    </t>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                </td>
                                                <td class="text-center">
                                                    <a t-attf-href="/my/rentals/#{order.id}" class="btn btn-sm btn-primary">View</a>
                                                    <t t-if="not order.x_active_change_request_id and order.state == 'sale'">
                                                        <a t-attf-href="/my/rentals/#{order.id}/change-request/new" class="btn btn-sm btn-secondary ms-1">Request Change</a>
                                                    </t>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Rental Order detail page -->
    <template id="portal_rental_order_page" name="Rental Order Details">
        <t t-call="portal.portal_layout">
            <t t-set="order" t-value="order"/>

            <div class="o_portal_sale_details container mt-3 mb-5">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">Rental Order <t t-out="order.name"/></h4>
                                <span class="badge bg-info text-white">
                                    <t t-out="order.state"/>
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Order Date:</strong> <t t-out="order.date_order"/><br/>
                                        <strong>Pickup Date:</strong> <t t-out="order.x_rental_pickup_date or '-'"/>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Total:</strong>
                                        <span t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </div>
                                </div>

                                <h5>Order Lines</h5>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th class="text-center">Qty</th>
                                            <th class="text-end">Unit Price</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="order.order_line" t-as="line">
                                            <td>
                                                <span t-out="line.product_id.display_name"/>
                                                <small class="d-block text-muted" t-if="line.product_id.default_code">
                                                    SKU: <t t-out="line.product_id.default_code"/>
                                                </small>
                                            </td>
                                            <td class="text-center"><t t-out="line.product_uom_qty"/></td>
                                            <td class="text-end">
                                                <span t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                            <td class="text-end">
                                                <strong>
                                                    <span t-out="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>

                                <t t-if="active_change_request">
                                    <div class="alert alert-info">
                                        <strong>Active Change Request:</strong>
                                        <a t-attf-href="/my/rentals/#{order.id}/change-request/#{active_change_request.id}">
                                            <t t-out="active_change_request.name"/>
                                        </a>
                                        (<span t-out="active_change_request.state"/>)
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-if="order.state == 'sale'">
                                        <a t-attf-href="/my/rentals/#{order.id}/change-request/new" class="btn btn-primary">
                                            Request Changes
                                        </a>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Change Request editor page (OWL app mount point) -->
    <template id="portal_change_request_page" name="Change Request Editor">
        <t t-call="portal.portal_layout">
            <t t-set="order" t-value="order"/>
            <t t-set="change_request" t-value="change_request"/>

            <div class="o_portal_change_request container mt-3 mb-5">
                <div class="row">
                    <div class="col-lg-12">
                        <!-- OWL App Mount Point -->
                        <div id="rental_change_request_app"
                             t-att-data-order-id="order.id"
                             t-att-data-change-request-id="change_request.id if change_request else 0"
                             t-att-data-csrf-token="request.csrf_token()">
                            <div class="text-center py-5 o_app_loading_indicator">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2 text-muted o_loading_fallback d-none">
                                    Si la pantalla no carga, por favor recarga la página (Ctrl+F5).
                                </p>
                            </div>
                            <script>
                                setTimeout(function() {
                                    var indicator = document.querySelector('.o_app_loading_indicator');
                                    var fallback = document.querySelector('.o_loading_fallback');
                                    // Only show fallback if the mount point still contains the indicator 
                                    // (meaning OWL hasn't cleared it yet)
                                    if (indicator &amp;&amp; fallback &amp;&amp; indicator.contains(fallback)) {
                                        fallback.classList.remove('d-none');
                                    }
                                }, 5000);
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
