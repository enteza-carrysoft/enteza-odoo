<!-- stock_picking_batch_report/views/stock_picking_batch_report_templates.xml -->

<odoo>
    <template id="report_stock_picking_batch">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Informe articulos agrupados por categoria y albaran</h2>
                        <p><strong>Agrupacion Albaranes:</strong> <span t-esc="doc.name"/></p>
                        <t t-foreach="doc.get_aggregated_products_by_category()" t-as="category_data">
                            <h3><span t-esc="category_data['category'].name"/></h3>
                            <table class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="category_data['products']" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-esc="line['product'].display_name"/>
                                            </td>
                                            <td>
                                                <span t-esc="line['quantity']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

