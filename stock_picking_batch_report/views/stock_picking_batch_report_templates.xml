<!-- stock_picking_batch_report/views/stock_picking_batch_report_templates.xml -->

<odoo>
    <template id="report_stock_picking_batch">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Stock Picking Batch Report</h2>
                        <p><strong>Batch Name:</strong> <span t-esc="doc.name"/></p>
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.get_aggregated_products()" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-esc="line['product'].display_name"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['quantity']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

